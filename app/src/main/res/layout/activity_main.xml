<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Baby Motion Alert"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open your baby cam app in full screen after starting. This app watches the screen (and optionally its sound) and alarms on movement or crying. Floating button: tap = attend snooze / re-arm, hold = pause."
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/sensitivityLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trigger threshold"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/sensitivitySeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="30"
        android:layout_marginBottom="24dp" />

    <Switch
        android:id="@+id/soundSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sound detection (crying)"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/soundLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sound sensitivity"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/soundSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="50"
        android:layout_marginBottom="24dp" />

    <Switch
        android:id="@+id/alarmSoundSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alarm sound"
        android:textSize="16sp"
        android:checked="true"
        android:layout_marginBottom="8dp" />

    <Switch
        android:id="@+id/flashlightSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Blink flashlight on alarm"
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <Switch
        android:id="@+id/clapSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Double-clap to snooze (while alarm rings)"
        android:textSize="16sp"
        android:checked="true"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/clapSensLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clap sensitivity"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/clapSensSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="50"
        android:layout_marginBottom="24dp" />

    <Switch
        android:id="@+id/clapDebugSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clap debug recording (saves WAV+CSV to Downloads)"
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/snoozeLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Attend snooze"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/snoozeSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="17"
        android:progress="7"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/alarmSoundButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alarm sound: System default" />

    <Button
        android:id="@+id/startButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start monitoring" />

    <Button
        android:id="@+id/stopButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop monitoring" />

    <Button
        android:id="@+id/accessibilityButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable auto-reconnect clicker" />

    <Button
        android:id="@+id/testButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test alarm + red flash" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: stopped"
        android:layout_marginTop="24dp"
        android:textSize="16sp" />
</LinearLayout>
</ScrollView>
